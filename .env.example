# ============================================================
#  Fast English — șablon de configurare
#  Copiază în `.env` și completează. Verifică cu: npm run env:check
# ============================================================

# ── OBLIGATORII ─────────────────────────────────────────────

# MongoDB — numele bazei trebuie inclus în URL (Prisma îl cere)
DATABASE_URL="mongodb+srv://USER:PAROLA@cluster.mongodb.net/fastenglish?retryWrites=true&w=majority"

NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""

# 64 caractere hex — node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# ── RECOMANDATE ─────────────────────────────────────────────

# Protejează /api/cron/*
CRON_SECRET=""

TOTP_APP_NAME="Fast English"
SESSION_EXPIRATION_HOURS="8"
STEP_UP_TOKEN_EXPIRATION="300"

# ── TELEGRAM — UN SINGUR BOT pentru tot ─────────────────────
# Botul trimite toate notificările (lecții, plăți, lead-uri, securitate, activitatea
# profesorilor, mesaje private) într-un singur grup cu Topics activate.
# Botul trebuie să fie admin în grup cu „Manage topics" pentru `npm run telegram:topics`.

# Token-ul botului (de la @BotFather)
TELEGRAM_LESSONS_BOT_TOKEN=""

# ID-ul grupului (ex: -1001234567890)
TELEGRAM_ADMIN_CHAT_ID=""

TELEGRAM_WEBHOOK_SECRET=""

# Cine primește copie după mesajele private trimise profesorilor (id-uri separate prin virgulă)
TELEGRAM_SUPERVISOR_CHAT_IDS=""

# Username-ul ACELUIAȘI bot (fără @) — pentru linkul de conectare a conturilor la Telegram
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""

# Completate automat de `npm run telegram:topics`
TELEGRAM_MISSED_LESSONS_THREAD_ID=""
TELEGRAM_LOW_LESSONS_THREAD_ID=""
TELEGRAM_PAYMENTS_THREAD_ID=""
TELEGRAM_CONTACT_THREAD_ID=""
TELEGRAM_ENROLLMENTS_THREAD_ID=""
TELEGRAM_TEACHER_ACTIVITIES_THREAD_ID=""
TELEGRAM_SECURITY_THREAD_ID=""

# ── OPȚIONALE ───────────────────────────────────────────────

# CAPTCHA la login (Cloudflare Turnstile)
CAPTCHA_PROVIDER="turnstile"
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
CAPTCHA_FAILURE_THRESHOLD="3"
CAPTCHA_RESET_HOURS="24"

# Upload imagini (Vercel Blob) — cursuri și recenzii
BLOB_READ_WRITE_TOKEN=""
# Alternativ: store-ul Vercel conectat cu prefixul „fastenglish" creează automat:
fastenglish_READ_WRITE_TOKEN=""

# Corectare AI (portalul elevului) — nefolosite momentan, păstrate 1:1 cu Olla
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
AI_GRADING_ENABLED="true"
AI_LIMIT_STUDENT_DAILY="20"
AI_LIMIT_IP_HOURLY="60"
AI_BUDGET_DAILY_USD="5"

# Rate limiting distribuit (fallback automat pe MongoDB)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Tuning
AUDIT_LOG_RETENTION_DAYS="90"
ARGON2_MEMORY_COST="19456"
ARGON2_TIME_COST="2"
ARGON2_PARALLELISM="1"

# Conturi inițiale pentru `npm run db:seed`
SEED_ADMIN_EMAIL="admin@fastenglish.md"
SEED_ADMIN_PASSWORD=""
SEED_TEACHER_EMAIL="profesor@fastenglish.md"
SEED_TEACHER_PASSWORD=""

# Opțional: superadmini creați/actualizați de scripts/make-superadmin.mjs (JSON)
# ex: [{"email":"admin@fastenglish.md","password":"...","name":"Admin"}]
SUPER_ADMINS=""

# ── Meta (paginile /admin/ads și /admin/messages) ───────────────────────
# Token de utilizator/system user cu drepturile ads_read + pages_show_list.
# Se ia din Meta Business → System Users → Generate token. NU se pune în cod.
META_ACCESS_TOKEN=""
# Opțional: doar anumite conturi de reclame (separate prin virgulă)
META_AD_ACCOUNT_IDS=""
# ID-ul paginii Fast English — doar campaniile ei apar în /admin/ads (gol = toate)
META_PAGE_IDS=""
# ID-ul paginii Fast English ale cărei mesaje se citesc în /admin/messages
# (obligatoriu pentru Mesaje și pentru lead-urile automate din conversații)
META_MESSAGES_PAGE_ID=""
# Token DE PAGINĂ pentru mesagerie (Messenger + Instagram).
# Mesajele Instagram cer capacități pe care le are doar un token generat
# pentru pagină, cu Advanced Access la instagram_manage_messages.
META_PAGE_ACCESS_TOKEN=""
